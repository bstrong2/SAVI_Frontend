# Adding an editor config file so any editor that's used from another developer or me will act the same.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,ts,vue}]
quote_type = single

[*.{css,html,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
